{
	"name": "legalab-site",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Legalab website: a static SvelteKit site built with Bazel",
	"homepage": "https://github.com/xoxd-ai/legalab",
	"repository": {
		"type": "git",
		"url": "https://github.com/xoxd-ai/legalab.git"
	},
	"license": "MIT",
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": "^22.17.0 || >=24 <25"
	},
	"scripts": {
		"dev": "just dev",
		"build": "just build",
		"check": "just check",
		"preview": "just preview",
		"lint": "just check"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@lucide/svelte": "^1.28.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.64.0",
		"@skeletonlabs/skeleton": "5.0.1",
		"@skeletonlabs/skeleton-svelte": "5.0.1",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.1",
		"@typescript/typescript6": "6.0.2",
		"@vitest/coverage-v8": "5.0.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.9.0",
		"magic-string": "^0.30.0",
		"mdsvex": "0.12.8",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-visualizer": "^7.0.1",
		"serve": "^14.2.6",
		"sharp": "^0.35.3",
		"shiki": "^4.4.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"svgo": "^4.0.2",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.5",
		"typescript": "7.0.2",
		"typescript-eslint": "^8.71.1",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	},
	"pnpm": {
		"overrides": {
			"cookie@<0.7.0": "0.7.2",
			"fast-uri": "3.1.2"
		},
		"packageExtensions": {
			"@sveltejs/kit@3.0.1": {
				"peerDependencies": {
					"@typescript/typescript6": "^6.0.0"
				},
				"peerDependenciesMeta": {
					"@typescript/typescript6": {
						"optional": true
					}
				}
			}
		},
		"peerDependencyRules": {
			"allowedVersions": {
				"@sveltejs/kit>typescript": "7"
			}
		},
		"patchedDependencies": {
			"@sveltejs/kit@3.0.1": "patches/@sveltejs__kit@3.0.1.patch",
			"devalue@5.9.4": "patches/devalue@5.9.4.patch",
			"svelte-check@4.7.6": "patches/svelte-check@4.7.6.patch"
		},
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"sharp"
		]
	}
}
